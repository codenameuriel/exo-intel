ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-generated-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000
CORS_ALLOWED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000,http://localhost:3000
SECURE_COOKIES=False

DATABASE_URL=sqlite:///db.sqlite3

CELERY_TIMEZONE=America/New_York
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_LOG_FILE=logs/celery_worker.log
CELERY_BEAT_LOG_FILE=logs/celery_beat.log
CELERY_BEAT_SCHEDULE_FILE=run/celerybeat-schedule

NASA_TAP_BASE_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
