ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-generated-production-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
# Set this to True when serving the application over HTTPS.
SECURE_COOKIES=False
DJANGO_LOG_LEVEL=INFO
DJANGO_ADMIN_URL=admin/

POSTGRES_DB=exo_intel
POSTGRES_USER=exo_intel
POSTGRES_PASSWORD=replace_with_a_url_safe_database_password
DATABASE_URL=postgresql://exo_intel:replace_with_a_url_safe_database_password@db:5432/exo_intel

CELERY_TIMEZONE=America/New_York
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_BEAT_SCHEDULE_FILE=/app/run/celerybeat-schedule

NASA_TAP_BASE_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
